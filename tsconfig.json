{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES5", "ES6", "ES7"],
		"paths": {
			"@src/*": ["src/*"],
			"@cmd/*": ["src/cmd/*"],
			"@component/*": ["src/component/*"],
			"@util/*": ["src/component/*"]
		}
	},
	"include": ["**/*.ts"]
}
